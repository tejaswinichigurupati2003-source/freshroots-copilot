# Supabase (free project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=

# Zoho: mock (default) or live
ZOHO_MODE=mock
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=

# Security
CRON_SECRET=
KILL_SWITCH_PIN=

# Loss thresholds (lakh per quarter)
LOSS_WARN_LAKH=40
LOSS_STOP_LAKH=50
BASELINE_LOSS_LAKH=30.75

# Monitor: decided lines needed in 30 days before the rejection rate counts (brief says 20; lower only for demos)
REJECTION_MIN_LINES=20

# Live Zoho only: where the SKU/distributor id map lives (default data/zoho_map.csv)
ZOHO_MAP_PATH=data/zoho_map.csv

# Demo: treat this date as "today" so the 2026-10-19 seed data counts as fresh
RUN_AS_OF=2026-10-19
